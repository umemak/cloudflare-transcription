{
  "name": "cloudflare-transcription",
  "version": "2.0.0",
  "description": "Audio transcription app using Cloudflare Workers, Containers (FFmpeg), D1, R2, and AI (Whisper)",
  "repository": {
    "type": "git",
    "url": "https://github.com/umemak/cloudflare-transcription.git"
  },
  "author": "umemak",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 3000",
    "build": "npm run generate-static && vite build && npm run fix-routes",
    "generate-static": "node scripts/generate-static-modules.js",
    "fix-routes": "node scripts/fix-routes.js",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply cloudflare-transcription-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply cloudflare-transcription-db"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.1.1",
    "hono": "^4.12.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "wrangler": "^4.71.0"
  }
}
